{
  "id": "03-readonly-sandbox-blocks-write",
  "description": "OS read-only sandbox physically blocks shell scripts from writing or overwriting workspace files",
  "prompt": "Inspect workspace via script without modifying any files",
  "accessMode": "automatic",
  "sandbox": {
    "profile": "read-only",
    "network": "off",
    "writableRoots": []
  },
  "files": {
    "readonly.txt": "SAFE",
    "try_write.cjs": "const fs = require('fs'); let err = ''; try { fs.writeFileSync('readonly.txt', 'PWN'); } catch (e) { err += e.code; } try { fs.writeFileSync('pwn.txt', '1'); } catch (e) { err += ':' + e.code; } console.log('SBX_BLOCKED=' + err);"
  },
  "responses": [
    {
      "body": {
        "usage": { "prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15 },
        "choices": [{
          "message": {
            "content": null,
            "tool_calls": [{
              "id": "sbx_ro_1",
              "type": "function",
              "function": {
                "name": "exec_command",
                "arguments": "{\"command\":\"node try_write.cjs\"}"
              }
            }]
          }
        }]
      }
    },
    {
      "body": {
        "usage": { "prompt_tokens": 10, "completion_tokens": 5, "total_tokens": 15 },
        "choices": [{ "message": { "content": "Read-only sandbox prevented writes." } }]
      }
    }
  ],
  "expected": {
    "expectedReason": "completed",
    "expectedFiles": {
      "readonly.txt": { "equals": "SAFE" }
    },
    "forbiddenFiles": ["pwn.txt"],
    "expectedRequestMatches": [{ "index": 1, "pattern": "SBX_BLOCKED=(?:EACCES|EROFS|EPERM):(?:EACCES|EROFS|EPERM)" }]
  }
}

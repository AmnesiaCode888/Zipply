{
  "name": "zipply",
  "productName": "Zipply",
  "version": "0.1.0",
  "description": "Zipply — Autonomous Desktop AI Coding Workspace",
  "main": "./out/main/index.js",
  "homepage": "https://zipply.my",
  "license": "BSL-1.1",
  "author": {
    "name": "Zipply",
    "email": "support@zipply.my",
    "url": "https://zipply.my"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AmnesiaCode888/Zipply.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev --watch",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --config.npmRebuild=false",
    "build:linux": "npm run build && electron-builder --linux AppImage deb",
    "build:appimage": "npm run build && electron-builder --linux AppImage",
    "build:deb": "npm run build && electron-builder --linux deb",
    "build:cli": "esbuild src/main/agent/cli.ts --bundle --platform=node --format=cjs --outfile=out/cli/zipply-agent.cjs --external:electron --external:node-pty --external:playwright-core",
    "agent:eval": "npm run build:cli && node out/cli/zipply-agent.cjs --eval tests/fixtures/harness",
    "test:e2e": "npm run build && node --test --test-concurrency=1 tests/e2e/*.test.cjs"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@number-flow/react": "^0.6.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "highlight.js": "^11.12.0",
    "ignore": "^7.0.14",
    "lucide-react": "^1.46.0",
    "mammoth": "^1.13.0",
    "material-file-icons": "^2.4.0",
    "motion": "^14.9.1",
    "node-pty": "^1.1.0",
    "pdf-parse": "^1.1.1",
    "picomatch": "^4.0.7",
    "postcss": "^8.4.49",
    "pyright": "^1.1.414",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-virtuoso": "^4.18.20",
    "sql.js": "^1.17.0",
    "typescript": "^5.9.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^20.17.10",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^2.3.0",
    "esbuild": "0.21.5",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
